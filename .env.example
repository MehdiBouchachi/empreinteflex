# Copy to .env. Never commit this file.
POSTGRES_DB=empreinteflex
POSTGRES_USER=efapp
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgres://efapp:CHANGE_TO_A_LONG_RANDOM_DB_PASSWORD@postgres:5432/empreinteflex
NODE_ENV=production
APP_PORT=3000
# Set to true ONLY when accessed through real HTTPS domains (see infra/caddy/Caddyfile.production)
COOKIE_SECURE=false
# First admin account. Seed creates it only if missing; use a unique strong password.
ADMIN_EMAIL=admin@empreinteflex.local
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_NAME=Empreinte Flex Admin
# Optional email; without SMTP outbox messages are held, not represented as sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Empreinte Flex <no-reply@example.com>
# Product images are stored in PostgreSQL BYTEA for MVP; R2 optional for future migration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=empreinteflex-media
R2_PUBLIC_URL=
# Public URL of API through same-origin proxy (used in browser)
NEXT_PUBLIC_API_BASE=/v1
API_INTERNAL_URL=http://api:3000
# Local default: view storefront at :8080 and staff at :8081
# For production use domain-ready Caddyfile and HTTPS, see README.
RESERVATION_TTL_HOURS=24

# Customer registration: enable ONLY for local/staging until email verification is implemented
CUSTOMER_REGISTRATION_ENABLED=false
# Contact form queues email through backend/worker; requires SMTP and destination mailbox
CONTACT_INBOX=
# Used by old /console bookmark redirect
STAFF_PUBLIC_URL=http://localhost:8081
