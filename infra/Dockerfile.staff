FROM node:22-bookworm-slim AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/staff/package.json apps/staff/package.json
COPY apps/storefront/package.json apps/storefront/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages/shared packages/shared
COPY apps/staff apps/staff
RUN pnpm --filter @ef/shared build && pnpm --filter @ef/staff build
FROM nginx:1.27-alpine
COPY --from=builder /app/apps/staff/dist /usr/share/nginx/html
COPY infra/nginx.staff.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
