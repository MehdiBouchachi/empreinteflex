FROM node:22-bookworm-slim AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/staff/package.json apps/staff/package.json
COPY apps/storefront/package.json apps/storefront/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages/shared packages/shared
COPY apps/api apps/api
COPY data data
RUN pnpm --filter @ef/shared build && pnpm --filter @ef/api build
FROM node:22-bookworm-slim
RUN corepack enable
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app /app
# Not exposed publicly: Caddy connects on Docker private network.
EXPOSE 3000
CMD ["sh","-c","node apps/api/dist/migrate.js && node apps/api/dist/seed.js && node apps/api/dist/main.js"]
